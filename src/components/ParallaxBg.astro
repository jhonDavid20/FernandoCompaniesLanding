---
/**
 * Full-bleed background photo that moves slower than the page (parallax).
 * Place inside a `relative isolate overflow-clip` section (not overflow-hidden: that creates a scroll container and stops the scroll timeline).
 *
 * - Modern browsers: pure CSS scroll-driven animation (no JS, off the main thread).
 * - Others (e.g. Firefox): small rAF fallback script.
 * - prefers-reduced-motion: static image, no movement.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** Dark overlay strength, 0–90 */
  overlay?: number;
  /** CSS object-position */
  position?: string;
  /** Load eagerly (only for the first section on a page) */
  eager?: boolean;
}
const { src, alt = '', overlay = 0, position = 'center', eager = false } = Astro.props;
---
<div class="parallax-bg pointer-events-none absolute inset-0 -z-10 overflow-clip" aria-hidden={alt ? undefined : 'true'}>
  <Image
    src={src}
    alt={alt}
    widths={eager ? [480, 800, 1280] : [640, 960, 1440, 1920]}
    sizes="100vw"
    quality={overlay >= 40 ? 50 : 70}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="parallax-img absolute inset-x-0 -top-[35%] h-[170%] w-full object-cover"
    style={`object-position:${position}`}
    data-parallax
  />
  {overlay > 0 && <div class="absolute inset-0 bg-ink" style={`opacity:${overlay / 100}`}></div>}
  <!-- soft vignette so the photo blends into the black sections around it -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_45%,rgb(17_17_17/0.55)_100%)]"></div>
</div>

<style is:global>
  /*
   * Layered parallax:
   * - .parallax-img    photo travels ~60% of the section height and eases out of a slight zoom
   * - .parallax-float  foreground content drifts the opposite way, so the two layers separate
   * - .parallax-reveal content fades/slides in as it enters the viewport
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .parallax-img {
        animation: parallax-bg linear both;
        animation-timeline: view();
        animation-range: cover;
        will-change: transform;
      }
      @keyframes parallax-bg {
        from { transform: translate3d(0, -18%, 0) scale(1.12); }
        50% { transform: translate3d(0, 0, 0) scale(1.04); }
        to { transform: translate3d(0, 18%, 0) scale(1); }
      }

      .parallax-float {
        animation: parallax-float linear both;
        animation-timeline: view();
        animation-range: cover;
      }
      @keyframes parallax-float {
        from { translate: 0 90px; }
        to { translate: 0 -90px; }
      }

      .parallax-reveal {
        animation: parallax-reveal ease-out both;
        animation-timeline: view();
        animation-range: entry 5% cover 35%;
      }
      @keyframes parallax-reveal {
        from { opacity: 0; clip-path: inset(12% 0 0 0); }
        to { opacity: 1; clip-path: inset(0 0 0 0); }
      }
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && !CSS.supports('animation-timeline: view()')) {
    const imgs = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    const floats = [...document.querySelectorAll<HTMLElement>('.parallax-float')];
    let ticking = false;
    const update = () => {
      const vh = window.innerHeight;
      for (const img of imgs) {
        const box = img.parentElement!.getBoundingClientRect();
        if (box.bottom < 0 || box.top > vh) continue;
        // progress: 0 when section enters at bottom, 1 when it leaves at top
        const p = (vh - box.top) / (vh + box.height);
        img.style.transform = `translate3d(0, ${(p - 0.5) * 36}%, 0) scale(${1.12 - p * 0.12})`;
      }
      for (const el of floats) {
        const box = el.getBoundingClientRect();
        if (box.bottom < -200 || box.top > vh + 200) continue;
        const p = (vh - box.top) / (vh + box.height);
        el.style.translate = `0 ${(0.5 - p) * 180}px`;
      }
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
