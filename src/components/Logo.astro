---
// SVG lockup modeled on the client's "Companies by Fernando" logo (gold ring + F mark).
// TODO(client): replace with the official vector logo once the brand name is confirmed.
interface Props { class?: string; tone?: 'light' | 'dark' }
const { class: cls = '', tone = 'dark' } = Astro.props;
const onDark = tone === 'light';
---
<span class:list={['inline-flex items-center gap-3', cls]}>
  <svg viewBox="0 0 40 40" class="size-10 shrink-0" aria-hidden="true">
    <circle cx="20" cy="20" r="17.5" fill="none" stroke="var(--color-gold)" stroke-width="3" />
    <path d="M14 13.5 27.5 10.5v4.6L14 18.1z" fill="var(--color-gold)" />
    <path d="M14 20.4 25.5 17.8v4.5L18.6 23.9c-.6 2.6-2 5.4-4.6 7.6z" fill="var(--color-gold)" />
  </svg>
  <span class="leading-none">
    <span class:list={['flex items-center gap-1.5 text-[0.55rem] font-bold tracking-[0.22em] uppercase', onDark ? 'text-paper/70' : 'text-mute']}>
      <span class="h-px w-3 bg-current" aria-hidden="true"></span>Companies by<span class="h-px w-3 bg-current" aria-hidden="true"></span>
    </span>
    <span class:list={['mt-1 block text-[1.2rem] font-bold tracking-[0.06em] uppercase', onDark ? 'text-gold' : 'text-ink']}>Fernando</span>
  </span>
</span>
