---
import { Image } from 'astro:assets';
import ParallaxBg from './ParallaxBg.astro';
import type { ProjectGroup } from '@/data/site';
interface Props { group: ProjectGroup; index: number }
const { group: g, index } = Astro.props;
const flip = index % 2 === 1;
const [bg, inset] = g.photos;
const id = `project-${index}`;
---
<article class="relative isolate overflow-clip bg-ink" aria-labelledby={id}>
  {bg && <ParallaxBg src={bg.src} alt={bg.alt} overlay={15} />}
  <div class:list={['wrap flex min-h-[100svh] items-center py-24 sm:py-32', flip && 'sm:justify-end']}>
    <div class="parallax-float w-full max-w-md">
      <div class="parallax-reveal border-t-2 border-gold bg-ink/95 p-6 text-paper shadow-[0_40px_80px_-20px_rgb(0_0_0/0.7)] backdrop-blur-sm sm:p-10">
        {inset && (
          <Image src={inset.src} alt={inset.alt} widths={[400, 640]} sizes="(min-width: 640px) 28rem, 100vw" class="mb-8 aspect-[16/10] w-full object-cover" />
        )}
        <p class="eyebrow text-gold">{String(index + 1).padStart(2, '0')}</p>
        <h3 id={id} class="display mt-3 text-3xl sm:text-4xl">{g.title}</h3>
        <span class="mt-5 block h-px w-10 bg-gold" aria-hidden="true"></span>
        <p class="mt-5 leading-relaxed text-paper/75">{g.text}</p>
      </div>
    </div>
  </div>
</article>
