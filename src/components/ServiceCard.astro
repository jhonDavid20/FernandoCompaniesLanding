---
/**
 * Photo card for one service. Hover (or keyboard focus) reveals the description.
 * On touch screens, where there is no hover, the description is always shown.
 */
import { Image } from 'astro:assets';
import type { Photo, Service } from '@/data/site';
import { t } from '@/data/site';
interface Props { service: Service; image: Photo; index: number }
const { service: s, image, index } = Astro.props;
const learnMore = t().servicesIntro.learnMore;
---
<a href={`/services#${s.slug}`} class="service-card group relative block aspect-[4/5] overflow-hidden xl:aspect-[2/3] bg-charcoal text-paper outline-offset-4">
  <Image
    src={image.src}
    alt={image.alt}
    widths={[400, 600, 800]}
    sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw"
    quality={70}
    class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-focus-visible:scale-105"
  />
  <!-- base gradient so the name is always readable -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/20 to-transparent" aria-hidden="true"></div>
  <!-- dark layer that rises on hover -->
  <div class="card-shade absolute inset-0 bg-ink/80" aria-hidden="true"></div>

  <div class="absolute inset-x-0 bottom-0 p-6 xl:p-5">
    <span class="eyebrow text-gold">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="display mt-2 text-3xl xl:text-[1.75rem]">{s.name}</h3>
    <div class="card-body">
      <div class="overflow-hidden">
        <span class="mt-3 block h-px w-10 bg-gold" aria-hidden="true"></span>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-paper/85 xl:text-sm">{s.summary}</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold tracking-[0.12em] uppercase text-gold">
          {learnMore} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  /* Collapsible body via grid rows (animates height without measuring) */
  .card-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s ease, opacity 0.35s ease;
  }
  .card-shade {
    opacity: 1;
    transition: opacity 0.45s ease;
  }
  @media (hover: hover) {
    .card-body {
      grid-template-rows: 0fr;
      opacity: 0;
    }
    .card-shade {
      opacity: 0;
    }
    .service-card:hover .card-body,
    .service-card:focus-visible .card-body {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .service-card:hover .card-shade,
    .service-card:focus-visible .card-shade {
      opacity: 1;
    }
  }
  /* Touch: lighter shade so the photo still shows */
  @media (hover: none) {
    .card-shade { opacity: 0.35; }
  }
</style>
