---
import { business, t } from '@/data/site';
import Logo from './Logo.astro';
const c = t();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href === path;
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="wrap flex h-16 items-center justify-between gap-6 lg:h-20">
    <a href="/" class="shrink-0" aria-label="Companies by Fernando — home"><Logo /></a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 font-serif text-[1.05rem] italic">
        {c.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="border-b border-transparent py-1 hover:border-ink aria-[current=page]:border-gold"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-6 md:flex">
      <a href={business.phone.href} class="text-sm font-bold tracking-wide hover:text-gold-deep">{business.phone.display}</a>
      <a href="/contact" class="btn btn-primary !min-h-11 !px-4">{c.cta.primary}</a>
    </div>

    <button
      type="button"
      class="-mr-2 inline-flex size-11 items-center justify-center md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path data-open d="M3 7h18M3 12h18M3 17h18" />
        <path data-close class="hidden" d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-line md:hidden">
    <ul class="wrap flex flex-col py-3 font-serif text-xl italic">
      {c.nav.map((item) => (
        <li><a href={item.href} class="block py-3" aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
      <li class="mt-3 flex flex-col gap-3 pb-3 font-sans not-italic">
        <a href="/contact" class="btn btn-primary">{c.cta.primary}</a>
        <a href={business.phone.href} class="btn btn-ghost">{c.cta.phone} {business.phone.display}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('hidden', !open);
      btn.querySelector('[data-open]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-close]')?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>
