---
import { business, t } from '@/data/site';
import Logo from './Logo.astro';
const c = t();
const year = new Date().getFullYear();
---
<footer class="bg-ink text-paper/75">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <Logo tone="light" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">{c.footer.tagline}</p>
    </div>
    {business.offices.map((o) => (
      <address class="not-italic text-sm leading-relaxed">
        <p class="eyebrow mb-2 text-gold">{o.label}</p>
        {o.street}, {o.suite}<br />{o.city}, {o.region} {o.postalCode}
      </address>
    ))}
    <div class="text-sm leading-relaxed">
      <p class="eyebrow mb-2 text-gold">Contact</p>
      <a href={business.phone.href} class="block py-1.5 hover:text-paper">{business.phone.display}</a>
      <a href={`mailto:${business.email}`} class="block break-all py-1.5 hover:text-paper">{business.email}</a>
      <nav aria-label="Footer" class="mt-4">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {c.nav.map((i) => <li><a href={i.href} class="inline-block py-1.5 hover:text-paper">{i.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="wrap py-5 text-xs text-paper/55">© {year} {business.legalName}. {c.footer.rights}</p>
  </div>
</footer>
